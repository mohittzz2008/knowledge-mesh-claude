# Special characters in the password (like @) must be percent-encoded.
# Example: @ becomes %40
DATABASE_URL=postgresql+psycopg://knowledge_mesh_app:your_password_here@localhost:5432/knowledge_mesh

# --- Auth (Clerk) ---
# Production: set CLERK_JWKS_URL (Clerk Dashboard > API Keys > Show JWT public key / JWKS URL).
# The API then verifies the signed session token and ignores the X-Clerk-User-Id header.
CLERK_JWKS_URL=
# Optional: reject tokens not issued by your Clerk instance (e.g. https://your-app.clerk.accounts.dev)
CLERK_ISSUER=
# Local development only. When CLERK_JWKS_URL is empty the API trusts X-Clerk-User-Id.
# Set to false anywhere that is reachable by other people.
ALLOW_INSECURE_DEV_AUTH=true

# --- Misc ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Enables the AI coach (without it the coach returns a clear "not configured" error)
GEMINI_API_KEY=
